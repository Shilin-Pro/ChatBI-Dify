# Dify ChatBI 配置
# 复制为 .env 后填入实际值（.env 不要提交）

# Dify 工作流应用的 API Key（app- 开头）
DIFY_APP_KEY=

# Dify API 地址
DIFY_BASE_URL=http://localhost/v1

# 演示页面端口
DEMO_PORT=8600

# MySQL 连接（工作流里配置，此处仅供脚本参考）
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=cd
DB_USER=root
DB_PASSWORD=
# 必须带 characterEncoding，否则中文显示成问号
DB_PROPERTIES=useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&useSSL=false&allowPublicKeyRetrieval=true
