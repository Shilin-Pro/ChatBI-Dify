      "data": {
        "code": "def main(sql_text: str, sql_json: list) -> dict:\n    # 1. 判断是否报错\n    if \"SQL 执行失败\" in sql_text or \"error\" in sql_text.lower():\n        return {\"status\": \"error\", \"message\": \"SQL执行出错\"}\n    \n    # 2. 判断是否为空数据（因为空数据时 json 是 [] 或者 text 只有表头）\n    # 如果插件返回了 json 数组，直接判断长度\n    if isinstance(sql_json, list) and len(sql_json) == 0:\n        return {\"status\": \"empty\", \"message\": \"查无数据\"}\n    \n    # 如果只有表头，没有真实数据行（通过计算行数判断）\n    lines = [line for line in sql_text.split('\\n') if line.strip()]\n    # 如果只有两行（表头 + 分隔线 |---|），说明没数据\n    if len(lines) <= 2:\n         return {\"status\": \"empty\", \"message\": \"查无数据\"}\n\n    # 3. 一切正常\n    return {\"status\": \"success\", \"message\": \"正常\"}",
